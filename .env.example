SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=boltiko.settings.docker
# ERR-132: secret admin mount (no trailing slash). Never "admin".
# Prod example (set in droplet .env, do not commit real value if unique):
# ADMIN_URL=blt-panel-k7m2xq9
ADMIN_URL=

POSTGRES_DB=boltiko
POSTGRES_USER=boltiko
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# Prod: domain + IP + docker aliases. Never leave DROPLET_IP literal.
ALLOWED_HOSTS=boltiko.com.ua,www.boltiko.com.ua,64.226.78.240,web,127.0.0.1,localhost
# HTTP-first (до SSL): http://…  | після certbot: https://…
CSRF_TRUSTED_ORIGINS=http://boltiko.com.ua,http://www.boltiko.com.ua,http://64.226.78.240
SITE_URL=http://boltiko.com.ua
USE_HTTPS=false
SECURE_SSL_REDIRECT=false
# 1 = seed категорій/сторінок, лише якщо БД порожня. Не вмикати разом із sync-data import.
BOOTSTRAP_SEED=0

NOVA_POSHTA_API_KEY=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@boltiko.com.ua
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
