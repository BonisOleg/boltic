SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=boltiko.settings.docker

POSTGRES_DB=boltiko
POSTGRES_USER=boltiko
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# Droplet IP + later domain. Always include: web,127.0.0.1,localhost
ALLOWED_HOSTS=DROPLET_IP,web,127.0.0.1,localhost
# HTTP test: http://DROPLET_IP  | after SSL: https://domain
CSRF_TRUSTED_ORIGINS=http://DROPLET_IP
SITE_URL=http://DROPLET_IP
USE_HTTPS=false
SECURE_SSL_REDIRECT=false

NOVA_POSHTA_API_KEY=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@boltiko.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
