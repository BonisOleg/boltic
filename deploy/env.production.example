# Скопіюй на Droplet як /var/www/boltiko/.env (або шлях клону репо).
# НЕ комітити. Після змін: docker compose … up -d --force-recreate web nginx
#
# Перед деплоєм: dig +short boltiko.com.ua  → має бути 64.226.78.240

SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=boltiko.settings.docker
# ERR-132: не /admin/, не manage (передбачувано). Без trailing slash.
ADMIN_URL=blt-panel-k7m2xq9

POSTGRES_DB=boltiko
POSTGRES_USER=boltiko
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432

ALLOWED_HOSTS=boltiko.com.ua,www.boltiko.com.ua,64.226.78.240,web,127.0.0.1,localhost
# Після certbot — лише https (CSRF / cookies / sitemap)
CSRF_TRUSTED_ORIGINS=https://boltiko.com.ua,https://www.boltiko.com.ua
SITE_URL=https://boltiko.com.ua
USE_HTTPS=true
# False: TLS у nginx; Gunicorn лишається HTTP (інакше /healthz/ → 301)
SECURE_SSL_REDIRECT=false
BOOTSTRAP_SEED=0

NOVA_POSHTA_API_KEY=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

GTM_CONTAINER_ID=GTM-M63C7Z3F
GOOGLE_FEED_CACHE_SECONDS=1800

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@boltiko.com.ua
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
